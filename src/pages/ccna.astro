---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Content from '../components/Content.astro';
import BaseHead from '../components/BaseHead.astro';
import MarkdownTree from '../components/MarkdownTree';

const pageParam = Astro.url.searchParams.get('page') ?? '';

const notes = import.meta.glob('../content/notas/CCNA/notes/**/*.md');
const pageSlugs = Object.keys(notes)
	.map((route) =>
		route
			.replace('../content/notas/CCNA/notes/', '')
			.replace(/\.md$/, ''),
	)
	.sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }));

let module;
let currentSlug: string | null = null;

if (pageParam) {
	const decodedFilename = decodeURIComponent(pageParam).trim();
	const baseName = decodedFilename.split('/').pop() ?? decodedFilename;
	const directRoute = `../content/notas/CCNA/notes/${decodedFilename}.md`;

	let targetRoute = notes[directRoute] ? directRoute : undefined;
	if (!targetRoute) {
		targetRoute = Object.keys(notes).find((r) => {
			const slug = r.replace('../content/notas/CCNA/notes/', '').replace(/\.md$/, '');
			return slug === decodedFilename || slug.split('/').pop() === baseName;
		});
	}

	if (targetRoute && notes[targetRoute]) {
		module = await notes[targetRoute]!();
		currentSlug = targetRoute.replace('../content/notas/CCNA/notes/', '').replace(/\.md$/, '');
	} else {
		module = await import('../content/notas/CCNA/index.md');
	}
} else {
	module = await import('../content/notas/CCNA/index.md');
}

const pageContent = (module as { default: unknown }).default;
const headings = typeof (module as any)?.getHeadings === 'function' ? (module as any).getHeadings() : [];
const pageTitle = pageParam ? decodeURIComponent(pageParam) : 'Notas CCNA';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={pageTitle} description="Notas CCNA" />
	</head>
	<body>
		<Header currentLang="es" />
		<main>
			<div class="content-wrapper">
				<Content Content={pageContent} pageSlugs={pageSlugs} currentSlug={currentSlug} title={`${decodeURIComponent(pageParam)}`} lang="es"/>
			</div>
			{headings.length > 0 && (
				<aside class="sidebar-wrapper">
					<MarkdownTree client:load headings={headings} lang="es" />
				</aside>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		width: 85%;
		max-width: 1400px;
		margin: auto;
		padding: 3em 1em;
	}

	.content-wrapper {
		flex: 1;
		min-width: 0;
		width: 100%;
		order: 1;
	}

	.sidebar-wrapper {
		order: -1;
		width: 100%;
	}

	@media (min-width: 1024px) {
		main {
			flex-direction: row;
			align-items: flex-start;
			justify-content: space-between;
			gap: 2.5rem;
		}

		.sidebar-wrapper {
			order: 2;
			width: auto;
			position: sticky;
			top: 2rem;
		}
	}
</style>
