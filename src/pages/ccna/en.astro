---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Content from '../../components/Content.astro';
import BaseHead from '../../components/BaseHead.astro';

const pageParam = Astro.url.searchParams.get('page') ?? '';

const notes = import.meta.glob('../../content/notas/CCNA/en/notes/**/*.md');
const pageSlugs = Object.keys(notes)
	.map((route) =>
		route
			.replace('../../content/notas/CCNA/en/notes/', '')
			.replace(/\.md$/, ''),
	)
	.sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }));

let module;
let currentSlug: string | null = null;

if (pageParam) {
	const decodedFilename = decodeURIComponent(pageParam).trim();
	const baseName = decodedFilename.split('/').pop() ?? decodedFilename;
	const directRoute = `../../content/notas/CCNA/en/notes/${decodedFilename}.md`;

	let targetRoute = notes[directRoute] ? directRoute : undefined;
	if (!targetRoute) {
		targetRoute = Object.keys(notes).find((r) => {
			const slug = r.replace('../../content/notas/CCNA/en/notes/', '').replace(/\.md$/, '');
			return slug === decodedFilename || slug.split('/').pop() === baseName;
		});
	}

	if (targetRoute && notes[targetRoute]) {
		module = await notes[targetRoute]!();
		currentSlug = targetRoute.replace('../../content/notas/CCNA/en/notes/', '').replace(/\.md$/, '');
	} else {
		module = await import('../../content/notas/CCNA/en/index.md');
	}
} else {
	module = await import('../../content/notas/CCNA/en/index.md');
}

const pageContent = (module as { default: unknown }).default;
const pageTitle = pageParam ? decodeURIComponent(pageParam) : 'CCNA Notes';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description="CCNA notes in English" />
	</head>
	<body>
		<Header currentLang="en" />
		<main>
			<Content
				Content={pageContent}
				pageSlugs={pageSlugs}
				currentSlug={currentSlug}
				title={`${decodeURIComponent(pageParam)}`}
				lang="en"
			/>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		display: flex;
		flex-direction: row;
		gap: 1rem;
	}
</style>
